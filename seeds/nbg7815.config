## Target platform
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_zyxel_nbg7815=y

## Compile all kernel modules
# CONFIG_ALL_KMODS=y

## Optional: SQM through the PPE shaper, and the PPE QoS page. hw_ppe.qos
## needs sqm-scripts from the builder's feed patch, and luci-app-qca-ppe-qos
## needs the builder's luci fork; with the stock feeds defconfig drops it.
#CONFIG_PACKAGE_qca-ppe-qos=y
#CONFIG_PACKAGE_luci-app-qca-ppe-qos=y

## ---------------------------------- PERSONAL CONFIG ----------------------------------
## Redundant Packages
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_luci-app-attendedsysupgrade=n
CONFIG_PACKAGE_attendedsysupgrade-common=n
CONFIG_HTOP_LMSENSORS=n
CONFIG_LIBCURL_MBEDTLS=n
CONFIG_LUA_ECO_MBEDTLS=n
CONFIG_PACKAGE_apk-mbedtls=n
CONFIG_PACKAGE_libustream-mbedtls=n

## LUCI & OpenWRT
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-aria2=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-app-https-dns-proxy=y
CONFIG_PACKAGE_luci-app-pbr=y
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_luci-app-ksmbd=y
CONFIG_PACKAGE_luci-app-thermals=y
CONFIG_PACKAGE_apk-openssl=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_wpad-mesh-openssl=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_block-mount=y
CONFIG_LIBCURL_OPENSSL=y
CONFIG_LUA_ECO_OPENSSL=y
CONFIG_OPENSSL_OPTIMIZE_SPEED=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libustream-openssl=y

## Replace dnsmasq with dnsmasq-full for nftset support
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_DEFAULT_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_odhcpd-ipv6only=n
CONFIG_DEFAULT_dnsmasq=n
CONFIG_DEFAULT_odhcpd-ipv6only=n

## USB Storage Support
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

## Ext4 File System Support
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_e2fsprogs=y

## XFS File System with reflink(snapshot) support
CONFIG_PACKAGE_kmod-fs-xfs=y
CONFIG_PACKAGE_coreutils-cp=y
CONFIG_PACKAGE_chattr=y
CONFIG_PACKAGE_lsattr=y

## NBG7815
#CONFIG_PACKAGE_nbg7815_ble_init=y

## Crash forensics: persist the kernel console and panic traces across
## reboots in the board's ramoops region; the image archives them to
## /root/pstore on the next boot.
CONFIG_PACKAGE_kmod-ramoops=y

## DEBUGGING TOOLS AND PACKAGES
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_iftop=y
CONFIG_PACKAGE_hdparm=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_iw-full=y
CONFIG_PACKAGE_ethtool-full=y

